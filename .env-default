FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051
FILEENGINE_MCP_TENANT=default
FILEENGINE_MCP_USER=AGENT_LDAP_USER
FILEENGINE_MCP_PASSWORD=CHANGEME
FILEENGINE_LDAP_ENDPOINT=ldap://localhost:1389
FILEENGINE_LDAP_DOMAIN=dc=rationalboxes,dc=com
FILEENGINE_LDAP_USER_BASE=ou=users,dc=rationalboxes,dc=com
FILEENGINE_LDAP_TENANT_BASE=ou=tenants,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_DN=cn=admin,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_PASSWORD=CHANGEME
# MCP_READ_ONLY=1 hides all write tools (read/browse only).
MCP_READ_ONLY=0
# MCP_ALLOW_DELETE=1 enables reversible soft_delete/undelete. Hard delete and
# version culling are never exposed under any flag.
MCP_ALLOW_DELETE=0

# Streamable HTTP transport (fileengine-mcp-http). Run behind TLS for remote use.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8089
MCP_TOKEN_TTL=3600

# Hardening / guardrails (layered on top of the LDAP/ACL decision in the core).
MCP_MAX_READ_BYTES=10485760
MCP_MAX_WRITE_BYTES=10485760
MCP_MAX_RESULTS=1000
# Comma-separated UIDs to sandbox an agent to a subtree (empty = unrestricted).
MCP_SUBTREE_ALLOWLIST=
# Audit log destination (a file path; empty = stderr). Never logs content/creds.
MCP_AUDIT_LOG_FILE=
